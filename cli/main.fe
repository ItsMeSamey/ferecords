// Native adapter. The core parser and writer above are host-independent.
use std::native::{Args, Arg}
use core::Option

extern {
    fn malloc(size: u64) -> *u8
    unsafe fn free(_ address: *u8)
    fn dup(fd: i32) -> i32
    fn close(fd: i32) -> i32
    fn fdopen(fd: i32, mode: *u8) -> *u8
    fn fgetc(stream: *u8) -> i32
    fn fputc(c: i32, stream: *u8) -> i32
    fn ferror(stream: *u8) -> i32
    fn fflush(stream: *u8) -> i32
    fn fclose(stream: *u8) -> i32
}

fn native_null(_ address: *u8) -> bool { address as u256 == 0 }

// Own one FILE and its duplicated descriptor. The original stdin/stdout remain open.
struct NativeStream { unsafe stream: *u8 }
impl NativeStream {
    fn open(_ fd: i32, _ mode_byte: u8, _ failure: Kind) -> Result<Kind, Self> {
        let mode = malloc(size: 2)
        if native_null(mode) { return Result::Err(Kind::Allocation) }
        unsafe {
            *mode = mode_byte
            *core::ptr::offset(mode, 1) = 0
        }
        let copied = dup(fd: fd)
        if copied < 0 {
            unsafe { free(mode) }
            return Result::Err(failure)
        }
        let stream = fdopen(fd: copied, mode: mode)
        unsafe { free(mode) }
        if native_null(stream) {
            let _ = close(fd: copied)
            return Result::Err(failure)
        }
        Result::Ok(unsafe { Self { stream } })
    }
    fn read(self) -> i32 { fgetc(stream: self.stream) }
    fn failed(self) -> bool { ferror(stream: self.stream) != 0 }
    fn sink(self) -> HostSink { unsafe { HostSink { stream: self.stream } } }
    fn close(own self, _ flush: bool) -> bool {
        var flushed = true
        if flush { flushed = fflush(stream: self.stream) == 0 }
        let closed = fclose(stream: self.stream) == 0
        flushed && closed
    }
}

// Borrowed synchronous capability. Main closes the owner only after every sink returns.
struct HostSink { unsafe stream: *u8 }
impl core::Copy for HostSink {}
impl ByteSink for HostSink {
    fn put(mut self, _ byte: u8) -> Result<Kind, ()> {
        if fputc(c: byte as i32, stream: self.stream) < 0 {
            Result::Err(Kind::Output)
        } else { Result::Ok(()) }
    }
}

struct CliConfig {
    mode: u8,
    width: u64,
    columns: [u64; 256],
    count: u64,
    chunk: u64,
    limits: Limits,
}

fn cli_matches<const N: usize>(_ arg: Arg, _ bytes: [u8; N]) -> bool {
    if arg.len() != N { return false }
    var i: usize = 0
    while i < N {
        if arg.byte_at(i) != bytes[i] { return false }
        i += 1
    }
    true
}

fn cli_number(_ arg: Arg) -> Result<(), u64> {
    if arg.len() == 0 { return Result::Err(()) }
    var value: u64 = 0
    var i: usize = 0
    while i < arg.len() {
        let c = arg.byte_at(i)
        if c < 48 || c > 57 { return Result::Err(()) }
        let digit = (c - 48) as u64
        if value > (0xffffffffffffffff - digit) / 10 { return Result::Err(()) }
        value = value * 10 + digit
        i += 1
    }
    Result::Ok(value)
}

fn cli_args(_ args: Args) -> Result<(), CliConfig> {
    if args.len() < 2 { return Result::Err(()) }
    var config = CliConfig {
        mode: 0, width: 0, columns: [0; 256], count: 0,
        chunk: 4096, limits: default_limits(),
    }
    let command = args.get(1)
    if cli_matches(command, [118, 97, 108, 105, 100, 97, 116, 101]) {
        if args.len() > 3 { return Result::Err(()) }
        if args.len() == 3 {
            config.width = match cli_number(args.get(2)) {
                Result::Ok(value) => value,
                Result::Err(()) => return Result::Err(()),
            }
            if config.width == 0 || config.width > 256 { return Result::Err(()) }
        }
    } else if cli_matches(command, [115, 101, 108, 101, 99, 116]) {
        config.mode = 1
        if args.len() < 3 || args.len() > 258 { return Result::Err(()) }
        var i: usize = 2
        while i < args.len() {
            let column = match cli_number(args.get(i)) {
                Result::Ok(value) => value,
                Result::Err(()) => return Result::Err(()),
            }
            config.columns[(i - 2)] = column
            config.count += 1
            i += 1
        }
    } else if cli_matches(command, [105, 110, 115, 112, 101, 99, 116]) {
        config.mode = 2
        if args.len() != 2 && args.len() != 3 && args.len() != 6 { return Result::Err(()) }
        if args.len() >= 3 {
            config.chunk = match cli_number(args.get(2)) {
                Result::Ok(value) => value,
                Result::Err(()) => return Result::Err(()),
            }
            if config.chunk == 0 || config.chunk > 4096 { return Result::Err(()) }
        }
        if args.len() == 6 {
            config.limits.field_bytes = match cli_number(args.get(3)) {
                Result::Ok(value) => value,
                Result::Err(()) => return Result::Err(()),
            }
            config.limits.raw_bytes = match cli_number(args.get(4)) {
                Result::Ok(value) => value,
                Result::Err(()) => return Result::Err(()),
            }
            config.limits.fields = match cli_number(args.get(5)) {
                Result::Ok(value) => value,
                Result::Err(()) => return Result::Err(()),
            }
            if config.limits.field_bytes == 0 || config.limits.raw_bytes == 0
                || config.limits.field_bytes > config.limits.raw_bytes
                || config.limits.raw_bytes > 1048576
                || config.limits.fields == 0 || config.limits.fields > 256 {
                return Result::Err(())
            }
        }
    } else {
        return Result::Err(())
    }
    Result::Ok(config)
}

fn cli_put(_ byte: u8) -> bool uses (output: mut ByteSink) {
    match output.put(byte) {
        Result::Ok(()) => true,
        Result::Err(_) => false,
    }
}

fn cli_text<T: core::AsBytes>(_ text: T) -> bool uses (output: mut ByteSink) {
    let bytes = text.as_bytes()
    var i: usize = 0
    while i < T::N {
        // Fixed-width string literals may include trailing zero padding.
        if bytes[i] != 0 && !cli_put(bytes[i]) { return false }
        i += 1
    }
    true
}

fn cli_help() -> bool uses (output: mut ByteSink) {
    // Short literals retain the native fixed-string representation without heap allocation.
    cli_text("FeRecords: strict CRLF ")
        && cli_text("CSV bytes (NUL ")
        && cli_text("rejected).\nUsage:\n  ")
        && cli_text("ferecords validate ")
        && cli_text("[WIDTH]\n  ferecords ")
        && cli_text("select COLUMN...\n  ")
        && cli_text("ferecords inspect ")
        && cli_text("[CHUNK [FIELD_LIMIT ")
        && cli_text("RAW_LIMIT ")
        && cli_text("FIELDS_LIMIT]]\nColumns ")
        && cli_text("are zero-based; ")
        && cli_text("duplicates and order ")
        && cli_text("are preserved.\nReads ")
        && cli_text("stdin. validate is ")
        && cli_text("silent; select writes ")
        && cli_text("CSV; inspect writes ")
        && cli_text("diagnostics.\nDefaults: ")
        && cli_text("field 16384 bytes, raw ")
        && cli_text("record 65536 bytes, 256 ")
        && cli_text("fields, chunk 4096 ")
        && cli_text("bytes.\nCaps: raw record ")
        && cli_text("1048576 bytes, fields ")
        && cli_text("256, chunk 4096. ")
        && cli_text("Positive limits ")
        && cli_text("only.\nField limit ")
        && cli_text("cannot exceed raw ")
        && cli_text("limit. WIDTH is 1..256; ")
        && cli_text("select takes 1..256 ")
        && cli_text("columns.\nExit: 0 ")
        && cli_text("success; 64 arguments; ")
        && cli_text("5 NUL; 6 bare CR; 7 ")
        && cli_text("bare LF; 8 misplaced ")
        && cli_text("quote;\n9 after quote; ")
        && cli_text("10 unclosed quote; 11 ")
        && cli_text("field limit; 12 raw ")
        && cli_text("limit; 13 field ")
        && cli_text("count;\n14 counter ")
        && cli_text("overflow; 15 ")
        && cli_text("allocation; 16 output; ")
        && cli_text("17 width; 18 missing ")
        && cli_text("column.\nLibrary codes: ")
        && cli_text("2 configuration; 3 ")
        && cli_text("range; 4 finished; 19 ")
        && cli_text("zero-field record.\nUse ")
        && cli_text("inspect for error code ")
        && cli_text("and zero-based byte, ")
        && cli_text("row and field ")
        && cli_text("positions.\n20 input ")
        && cli_text("failure. Read errors ")
        && cli_text("are distinct from ")
        && cli_text("EOF.\nEarlier rows may ")
        && cli_text("be output before ")
        && cli_text("failure. Output is ")
        && cli_text("flushed and closed;\nthe ")
        && cli_text("first error is ")
        && cli_text("preserved. Broken pipes ")
        && cli_text("may terminate via ")
        && cli_text("SIGPIPE.\nSuccessful ")
        && cli_text("output is not a ")
        && cli_text("filesystem durability ")
        && cli_text("guarantee.\n")
}

fn cli_decimal(_ value: u64) -> bool uses (output: mut ByteSink) {
    var digits: [u8; 20] = [0; 20]
    var number = value
    var count: usize = 0
    while true {
        let digit: u8 = (number % 10).downcast_unchecked()
        digits[count] = digit + 48
        count += 1
        number /= 10
        if number == 0 { break }
    }
    while count > 0 {
        count -= 1
        if !cli_put(digits[count]) { return false }
    }
    true
}

fn cli_hex(_ byte: u8) -> bool uses (output: mut ByteSink) {
    let high = byte / 16
    let low = byte % 16
    cli_put(if high < 10 { high + 48 } else { high + 87 })
        && cli_put(if low < 10 { low + 48 } else { low + 87 })
}

fn cli_row(_ record: Record) -> bool uses (output: mut ByteSink) {
    if !cli_put(82) || !cli_put(32) || !cli_decimal(record.field_count()) { return false }
    var field: u64 = 0
    while field < record.field_count() {
        if !cli_put(32) { return false }
        let length = record.field_len(field)
        if length == 0 {
            if !cli_put(45) { return false }
        } else {
            var i: u64 = 0
            while i < length {
                if !cli_hex(record.byte_at(field, i)) { return false }
                i += 1
            }
        }
        field += 1
    }
    cli_put(10)
}

struct CliRecords {
    mode: u8, width: u64, columns: [u64; 256], count: u64,
    output: Option<HostSink>,
}
impl RecordSink for CliRecords {
    fn accept(mut self, _ record: Record, _ offset: u64, _ row: u64) -> Result<Failure, ()> {
        if self.width != 0 && record.field_count() != self.width {
            return Result::Err(Failure { kind: Kind::Width, offset, row, field: record.field_count() })
        }
        if self.mode == 0 { return Result::Ok(()) }
        var output = match self.output {
            Option::Some(sink) => sink,
            Option::None => return Result::Err(Failure { kind: Kind::Output, offset, row, field: 0 }),
        }
        with (ByteSink = output) {
            if self.mode == 1 {
                return write_selected(record, self.columns, self.count, offset, row)
            }
            if cli_row(record) { Result::Ok(()) } else {
                Result::Err(Failure { kind: Kind::Output, offset, row, field: 0 })
            }
        }
    }
}

fn cli_error(_ failure: Failure) -> bool uses (output: mut ByteSink) {
    cli_put(69) && cli_put(32) && cli_decimal(failure.kind.code() as u64)
        && cli_put(32) && cli_decimal(failure.offset)
        && cli_put(32) && cli_decimal(failure.row)
        && cli_put(32) && cli_decimal(failure.field) && cli_put(10)
}

fn cli_stats(_ parser: Parser, _ input_capacity: u64) -> bool uses (output: mut ByteSink) {
    cli_put(83) && cli_put(32) && cli_decimal(parser.records_seen())
        && cli_put(32) && cli_decimal(parser.position())
        && cli_put(32) && cli_decimal(parser.record_capacity())
        && cli_put(32) && cli_decimal(2048)
        && cli_put(32) && cli_decimal(input_capacity) && cli_put(10)
}

fn cli_run(_ config: CliConfig, _ output: Option<HostSink>) -> i32 uses (records: mut RecordSink) {
    var parser = Parser::new(config.limits)
    var input = ByteBuffer::new()
    if !input.try_resize(config.chunk) {
        input.release()
        parser.release()
        return 15
    }
    let reader = match NativeStream::open(0, 114, Kind::Input) {
        Result::Ok(stream) => stream,
        Result::Err(kind) => {
            input.release()
            parser.release()
            return kind.code() as i32
        },
    }
    var amount: u64 = 0
    var done = false
    var result: Result<Failure, ()> = Result::Ok(())
    while !done {
        let c = reader.read()
        if c < 0 {
            let source_failed = reader.failed()
            if amount > 0 { result = parser.feed(input, 0, amount) }
            match result {
                Result::Ok(()) => {
                    if source_failed {
                        result = Result::Err(Failure {
                            kind: Kind::Input, offset: parser.position(),
                            row: parser.records_seen(), field: 0,
                        })
                    } else { result = parser.finish() }
                },
                Result::Err(_) => {},
            }
            done = true
        } else {
            input.set_byte(index: amount, value: c.downcast_unchecked())
            amount += 1
            if amount == config.chunk {
                result = parser.feed(input, 0, amount)
                amount = 0
                match result {
                    Result::Err(_) => { done = true },
                    Result::Ok(()) => {},
                }
            }
        }
    }
    if !reader.close(false) {
        match result {
            Result::Ok(()) => {
                result = Result::Err(Failure {
                    kind: Kind::Input, offset: parser.position(),
                    row: parser.records_seen(), field: 0,
                })
            },
            Result::Err(_) => {},
        }
    }
    var status: i32 = 0
    match result {
        Result::Err(failure) => {
            status = failure.kind.code() as i32
            if config.mode == 2 {
                match output {
                    Option::Some(sink) => {
                        var target = sink
                        with (ByteSink = target) { let _ = cli_error(failure) }
                    },
                    Option::None => {},
                }
            }
        },
        Result::Ok(()) => {},
    }
    if config.mode == 2 {
        match output {
            Option::Some(sink) => {
                var target = sink
                with (ByteSink = target) {
                    if !cli_stats(parser, input.capacity()) && status == 0 { status = 16 }
                }
            },
            Option::None => {},
        }
    }
    input.release()
    parser.release()
    status
}

pub fn main(argc: i32, argv: **u8) -> i32 {
    let args = unsafe { Args::new(argc, argv) }
    if args.len() == 2 && cli_matches(args.get(1), [45, 45, 104, 101, 108, 112]) {
        let output = match NativeStream::open(1, 119, Kind::Output) {
            Result::Ok(stream) => stream,
            Result::Err(kind) => return kind.code() as i32,
        }
        var status: i32 = 0
        with (ByteSink = output.sink()) {
            if !cli_help() { status = 16 }
        }
        if !output.close(true) && status == 0 { status = 16 }
        return status
    }
    let config = match cli_args(args) {
        Result::Ok(value) => value,
        Result::Err(()) => return 64,
    }
    // Validation does not need stdout to exist or be writable.
    if config.mode == 0 {
        with (RecordSink = CliRecords {
            mode: config.mode, width: config.width,
            columns: config.columns, count: config.count, output: Option::None,
        }) {
            return cli_run(config, Option::None)
        }
    }
    let output = match NativeStream::open(1, 119, Kind::Output) {
        Result::Ok(stream) => stream,
        Result::Err(kind) => return kind.code() as i32,
    }
    let sink = output.sink()
    var status: i32 = 0
    with (RecordSink = CliRecords {
        mode: config.mode, width: config.width,
        columns: config.columns, count: config.count, output: Option::Some(sink),
    }) {
        status = cli_run(config, Option::Some(sink))
    }
    // Always flush and close; retain any earlier parser, source or sink failure.
    if !output.close(true) && status == 0 { status = 16 }
    status
}
