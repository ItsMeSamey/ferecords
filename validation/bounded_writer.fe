// Independently specified canonical budgets and round trips at native hard limits.
struct BudgetCollector { bytes: ByteBuffer, maximum: u64 }
impl ByteSink for BudgetCollector {
    fn put(mut self, _ byte: u8) -> Result<Kind, ()> {
        let size = self.bytes.len()
        core::assert(size < self.maximum)
        core::assert(self.bytes.try_resize(size + 1))
        self.bytes.set_byte(index: size, value: byte)
        Result::Ok(())
    }
}
struct UniformRows { fields: u64, length: u64, byte: u8, accepted: u64 }
impl RecordSink for UniformRows {
    fn accept(mut self, _ record: Record, _ offset: u64, _ row: u64) -> Result<Failure, ()> {
        let _ = offset
        core::assert(row == 0 && self.accepted == 0 && record.field_count() == self.fields)
        var field: u64 = 0
        while field < self.fields {
            core::assert(record.field_len(field) == self.length)
            var pos: u64 = 0
            while pos < self.length {
                core::assert(record.byte_at(field, pos) == self.byte)
                pos += 1
            }
            field += 1
        }
        self.accepted += 1
        Result::Ok(())
    }
}
fn budget_record(_ length: u64, _ byte: u8) -> Record {
    var input = ByteBuffer::new()
    core::assert(input.try_resize(length))
    var pos: u64 = 0
    while pos < length { input.set_byte(index: pos, value: byte)
        pos += 1 }
    var record = Record::new()
    match record.push_field(input, 0, length) { Result::Ok(()) => {}, _ => core::panic() }
    input.release()
    record
}
fn budget_result(_ result: Result<Failure, ()>, _ code: u8, _ field: u64) {
    match result {
        Result::Ok(()) => core::assert(code == 0),
        Result::Err(error) => {
            core::assert(error.kind.code() == code)
            core::assert(error.offset == 88 && error.row == 7 && error.field == field)
        },
    }
}
fn budget_case(_ length: u64, _ byte: u8, _ copies: u64, _ expected_raw: u64, _ raw_budget: u64, _ succeeds: bool) {
    let record = budget_record(length, byte)
    let columns: [u64; 256] = [0; 256]
    match canonical_raw_size(record, columns, copies, 88, 7) {
        Result::Ok(actual) => core::assert(actual == expected_raw),
        _ => core::panic(),
    }
    let limits = Limits { field_bytes: if length == 0 { 1 } else { length }, raw_bytes: raw_budget, fields: copies }
    var output = BudgetCollector { bytes: ByteBuffer::new(), maximum: if succeeds { expected_raw + 2 } else { 0 } }
    with (ByteSink = output) {
        if copies == 1 {
            budget_result(write_record_bounded(record, limits, 88, 7), if succeeds { 0 } else { 12 }, 0)
        } else {
            budget_result(write_selected_bounded(record, columns, copies, limits, 88, 7), if succeeds { 0 } else { 12 }, 0)
        }
    }
    if succeeds {
        core::assert(output.bytes.len() == expected_raw + 2)
        core::assert(output.bytes.byte_at(expected_raw) == 13 && output.bytes.byte_at(expected_raw + 1) == 10)
        var parser = Parser::new(limits)
        var rows = UniformRows { fields: copies, length, byte, accepted: 0 }
        with (RecordSink = rows) {
            var pos: u64 = 0
            while pos < output.bytes.len() {
                let remaining = output.bytes.len() - pos
                let amount = if remaining > 4093 { 4093 } else { remaining }
                match parser.feed(output.bytes, pos, amount) { Result::Ok(()) => {}, _ => core::panic() }
                pos += amount
            }
            match parser.finish() { Result::Ok(()) => {}, _ => core::panic() }
        }
        core::assert(rows.accepted == 1 && parser.records_seen() == 1)
        core::assert(parser.position() == expected_raw + 2)
        parser.release()
    } else {
        core::assert(output.bytes.len() == 0 && output.bytes.capacity() == 0)
    }
    output.bytes.release()
    record.release()
}
#[test]
fn hard_raw_exact_plain_roundtrip() { budget_case(1048574, 97, 1, 1048576, 1048576, true) }
#[test]
fn hard_raw_one_over_plain_preflight() { budget_case(1048575, 97, 1, 1048577, 1048576, false) }
#[test]
fn hard_raw_exact_quote_roundtrip() { budget_case(524287, 34, 1, 1048576, 1048576, true) }
#[test]
fn hard_raw_over_quote_preflight() { budget_case(524288, 34, 1, 1048578, 1048576, false) }
#[test]
fn near_hard_raw_duplicate_projection_roundtrip() { budget_case(524285, 97, 2, 1048575, 1048576, true) }
#[test]
fn hard_raw_duplicate_projection_over_preflight() { budget_case(524286, 97, 2, 1048577, 1048576, false) }
#[test]
fn empty_field_exact_budget() { budget_case(0, 97, 1, 2, 2, true) }
#[test]
fn empty_field_budget_too_small() { budget_case(0, 97, 1, 2, 1, false) }
#[test]
fn default_field_size_derived_budget() { budget_case(16384, 97, 1, 16386, 16386, true) }
#[test]
fn default_field_size_one_under_derived_budget() { budget_case(16384, 97, 1, 16386, 16385, false) }
#[test]
fn bounded_writer_invalid_limits_and_selection_emit_nothing() {
    let record = budget_record(2, 97)
    var output = BudgetCollector { bytes: ByteBuffer::new(), maximum: 0 }
    var columns: [u64; 256] = [0; 256]
    with (ByteSink = output) {
        budget_result(write_record_bounded(record, Limits { field_bytes: 0, raw_bytes: 4, fields: 1 }, 88, 7), 2, 0)
        budget_result(write_record_bounded(record, Limits { field_bytes: 1, raw_bytes: 4, fields: 1 }, 88, 7), 11, 0)
        budget_result(write_selected_bounded(record, columns, 2, Limits { field_bytes: 2, raw_bytes: 9, fields: 1 }, 88, 7), 13, 2)
        columns[1] = 1
        budget_result(write_selected_bounded(record, columns, 2, Limits { field_bytes: 2, raw_bytes: 9, fields: 2 }, 88, 7), 18, 1)
    }
    core::assert(output.bytes.len() == 0 && output.bytes.capacity() == 0)
    output.bytes.release()
    record.release()
}
